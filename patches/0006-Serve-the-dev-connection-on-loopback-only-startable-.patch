@@ -0,0 +1,61 @@
+package io.rebble.libpebblecommon.connection.devconnection
+
+import io.rebble.libpebblecommon.connection.FakeLibPebble
+import io.rebble.libpebblecommon.connection.PebbleSocketIdentifier
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.emptyFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import java.net.ConnectException
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.NetworkInterface
+import java.net.Socket
+import kotlin.test.Test
+import kotlin.test.assertFailsWith
+import kotlin.test.assertTrue
+
+/**
+ * Gravel serves the dev connection on loopback only (it has no authentication); an upstream
+ * sync that puts back a wildcard bind fails here.
+ */
+class DevConnectionServerTest {
+    private fun canConnect(address: InetAddress): Boolean = try {
+        Socket().use { it.connect(InetSocketAddress(address, DevConnectionServer.PORT), 500) }
+        true
+    } catch (e: ConnectException) {
+        false
+    }
+
+    @Test
+    fun listensOnLoopbackOnly() = runBlocking {
+        val server = DevConnectionServer(FakeLibPebble())
+        val job = launch(Dispatchers.IO) {
+            server.start(PebbleSocketIdentifier("test"), emptyFlow(), emptyFlow()) {}
+        }
+        try {
+            val loopback = InetAddress.getByName(DevConnectionServer.LISTEN_HOST)
+            withTimeout(10_000) {
+                while (!canConnect(loopback)) delay(100)
+            }
+
+            val external = NetworkInterface.getNetworkInterfaces().asSequence()
+                .filter { it.isUp && !it.isLoopback }
+                .flatMap { it.inetAddresses.asSequence() }
+                .filter { !it.isLoopbackAddress && !it.isLinkLocalAddress }
+                .toList()
+            for (address in external) {
+                assertFailsWith<ConnectException>("reachable on $address") {
+                    Socket().use { it.connect(InetSocketAddress(address, DevConnectionServer.PORT), 500) }
+                }
+            }
+            assertTrue(loopback.isLoopbackAddress)
+        } finally {
+            job.cancelAndJoin()
+            server.stop()
+        }
+    }
+}
