@@ -0,0 +1,65 @@
+package io.rebble.libpebblecommon.packets
+
+import assertIs
+import io.rebble.libpebblecommon.protocolhelpers.PebblePacket
+import io.rebble.libpebblecommon.services.VoiceService
+import io.rebble.libpebblecommon.voice.VoiceEncoderInfo
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+/**
+ * Pins Gravel's reading of consnop's patched firmware: the spoken language rides in the session
+ * setup as attribute 0x40, and a change during the recording comes as voice command 0x40. The bytes
+ * are the ones that firmware's test_voice_endpoint expects it to send.
+ */
+internal class VoiceLanguagePacketTest {
+    private fun frame(payload: List<Int>): UByteArray =
+        (listOf(payload.size shr 8, payload.size and 0xff, 0x2a, 0xf8) + payload).map { it.toUByte() }.toUByteArray()
+
+    private val speexAttribute = listOf(0x01, 0x1d, 0x00) + "1.2rc1".map { it.code } + List(14) { 0 } +
+        listOf(0x80, 0x3e, 0x00, 0x00, 0x00, 0x32, 0x04, 0x40, 0x01)
+
+    @Test
+    fun sessionSetupCarriesTheLanguage() {
+        val packet = PebblePacket.deserialize(
+            frame(
+                listOf(0x01, 0, 0, 0, 0, 0x01, 0x07, 0x00, 0x02) + speexAttribute +
+                    listOf(0x40, 0x02, 0x00, 's'.code, 'k'.code),
+            ),
+        )
+        assertIs<SessionSetupCommand>(packet)
+        assertEquals(7u, packet.sessionId.get())
+        assertEquals("sk", VoiceService.languageOf(packet.attributes))
+        assertTrue(VoiceEncoderInfo.fromProtocol(packet.attributes) is VoiceEncoderInfo.Speex)
+    }
+
+    @Test
+    fun aSetupWithoutTheAttributeHasNoLanguage() {
+        val packet = PebblePacket.deserialize(frame(listOf(0x01, 0, 0, 0, 0, 0x01, 0x07, 0x00, 0x01) + speexAttribute))
+        assertIs<SessionSetupCommand>(packet)
+        assertNull(VoiceService.languageOf(packet.attributes))
+    }
+
+    @Test
+    fun languageChangeDecodes() {
+        val packet = PebblePacket.deserialize(
+            frame(listOf(0x40, 0, 0, 0, 0, 0x07, 0x00, 0x01, 0x40, 0x02, 0x00, 'd'.code, 'e'.code)),
+        )
+        assertIs<SessionLanguageCommand>(packet)
+        assertEquals(7u, packet.sessionId.get())
+        assertEquals("de", VoiceService.languageOf(packet.attributes))
+    }
+
+    @Test
+    fun malformedCodesAreIgnored() {
+        for (code in listOf(listOf('e'.code), listOf('e'.code, 'n'.code, 'g'.code), listOf('1'.code, '2'.code), listOf(0xc3, 0xa9))) {
+            val packet = PebblePacket.deserialize(
+                frame(listOf(0x40, 0, 0, 0, 0, 0x07, 0x00, 0x01, 0x40, code.size, 0x00) + code),
+            )
+            assertIs<SessionLanguageCommand>(packet)
+            assertNull(VoiceService.languageOf(packet.attributes), "code $code")
+        }
+    }
+}
