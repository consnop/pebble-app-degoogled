diff --git a/libpebble3/src/commonTest/kotlin/io/rebble/libpebblecommon/packets/VoiceLanguagePacketTest.kt b/libpebble3/src/commonTest/kotlin/io/rebble/libpebblecommon/packets/VoiceLanguagePacketTest.kt
