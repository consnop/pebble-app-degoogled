+    companion object {
+        /** The language attribute's code, or null when absent or not two ASCII letters. */
+        internal fun languageOf(attributes: List<VoiceAttribute>): String? {
+            val data = attributes.firstOrNull { it.id.get() == VoiceAttributeType.Language.value }
