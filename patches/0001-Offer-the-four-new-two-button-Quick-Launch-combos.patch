From 8616193f36d31920416dcd93fa1c0b5a61f1d4c3 Mon Sep 17 00:00:00 2001
From: consnop <consnop@users.noreply.github.com>
Date: Sun, 8 Nov 2026 16:19:33 +0100
Subject: [PATCH 1/4] Offer the four new two-button Quick Launch combos

consnop/PebbleOS adds Back+Select, Back+Down, Up+Select and Select+Down
to the two combos the firmware already had, stored under qlComboBackSelect,
qlComboBackDown, qlComboUpSelect and qlComboSelectDown. List them in the
Quick Launch section next to the existing two.

Gravel only writes a watch pref that has a stored value, so on stock
firmware these stay untouched unless set.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01J4cyE5MpWNo2QG1iuNRXKQ
---
 .../libpebblecommon/database/entity/WatchPrefEntity.kt       | 5 +++++
 .../kotlin/coredevices/pebble/ui/WatchPrefsScreen.kt         | 4 ++++
 2 files changed, 9 insertions(+)

diff --git a/libpebble3/src/commonMain/kotlin/io/rebble/libpebblecommon/database/entity/WatchPrefEntity.kt b/libpebble3/src/commonMain/kotlin/io/rebble/libpebblecommon/database/entity/WatchPrefEntity.kt
index fe53088c..3ae6af92 100644
--- a/libpebble3/src/commonMain/kotlin/io/rebble/libpebblecommon/database/entity/WatchPrefEntity.kt
+++ b/libpebble3/src/commonMain/kotlin/io/rebble/libpebblecommon/database/entity/WatchPrefEntity.kt
@@ -293,6 +293,11 @@ enum class QuicklaunchWatchPref(
     QlBack("qlBack", "Quick Launch: Hold Back", QuickLaunchSetting(true, QUIET_TIME_TOGGLE_UUID)),
     QlComboBackUp("qlComboBackUp", "Quick Launch: Hold Combo Back+Up", QuickLaunchSetting(false, null)),
     QlComboUpDown("qlComboUpDown", "Quick Launch: Hold Combo Up+Down", QuickLaunchSetting(false, null)),
+    // Fork: the other four two-button combos, in firmware that has them (consnop/PebbleOS).
+    QlComboBackSelect("qlComboBackSelect", "Quick Launch: Hold Combo Back+Select", QuickLaunchSetting(false, null)),
+    QlComboBackDown("qlComboBackDown", "Quick Launch: Hold Combo Back+Down", QuickLaunchSetting(false, null)),
+    QlComboUpSelect("qlComboUpSelect", "Quick Launch: Hold Combo Up+Select", QuickLaunchSetting(false, null)),
+    QlComboSelectDown("qlComboSelectDown", "Quick Launch: Hold Combo Select+Down", QuickLaunchSetting(false, null)),
     QlSingleClickUp(
         "qlSingleClickUp",
         "Quick Launch: Tap Up",
diff --git a/pebble/src/commonMain/kotlin/coredevices/pebble/ui/WatchPrefsScreen.kt b/pebble/src/commonMain/kotlin/coredevices/pebble/ui/WatchPrefsScreen.kt
index 0682734a..a86b1b81 100644
--- a/pebble/src/commonMain/kotlin/coredevices/pebble/ui/WatchPrefsScreen.kt
+++ b/pebble/src/commonMain/kotlin/coredevices/pebble/ui/WatchPrefsScreen.kt
@@ -191,6 +191,10 @@ fun WatchPref<*>.section(): Section = when (this) {
     QuicklaunchWatchPref.QlDown -> Section.QuickLaunch
     QuicklaunchWatchPref.QlComboBackUp -> Section.QuickLaunch
     QuicklaunchWatchPref.QlComboUpDown -> Section.QuickLaunch
+    QuicklaunchWatchPref.QlComboBackSelect -> Section.QuickLaunch
+    QuicklaunchWatchPref.QlComboBackDown -> Section.QuickLaunch
+    QuicklaunchWatchPref.QlComboUpSelect -> Section.QuickLaunch
+    QuicklaunchWatchPref.QlComboSelectDown -> Section.QuickLaunch
     QuicklaunchWatchPref.QlSelect -> Section.QuickLaunch
     QuicklaunchWatchPref.QlBack -> Section.QuickLaunch
     QuicklaunchWatchPref.QlSingleClickUp -> Section.QuickLaunch
