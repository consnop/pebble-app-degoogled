+    // Release downloads are served as application/octet-stream, so the body is decoded here rather
+    // than by the client's content negotiation.
+    private suspend fun fetchPatchedFeed(): Fetched<PatchedFeedDto> {
+        val response = try {
+            httpClient.get(PATCHED_FEED_URL)
+        } catch (e: IOException) {
+            logger.w(e) { "Network error fetching $PATCHED_FEED_URL" }
+            return Fetched.Failure(GENERIC_FAILURE)
+        }
+        if (response.status == HttpStatusCode.NotFound) return Fetched.NotFound
+        if (!response.status.isSuccess()) {
+            logger.w { "Patched firmware feed fetch failed: ${response.status}" }
+            return Fetched.Failure(GENERIC_FAILURE)
+        }
+        return try {
+            Fetched.Success(patchedFeedJson.decodeFromString<PatchedFeedDto>(response.bodyAsText()))
+        } catch (e: SerializationException) {
+            logger.w(e) { "Malformed patched firmware feed" }
+            Fetched.Failure(GENERIC_FAILURE)
+        } catch (e: IllegalArgumentException) {
+            logger.w(e) { "Malformed patched firmware feed" }
+            Fetched.Failure(GENERIC_FAILURE)
+        }
+    }
+
+    /**
+     * Null unless the feed is a known version and lists a verifiable build for [revision]. The download
+     * URL is built here from the tag and the expected asset name, never taken from the feed.
+     */
+    private fun PatchedFeedDto.verifiedBuildFor(revision: String): VerifiedBuild? {
+        if (version != PATCHED_FEED_VERSION || !PATCHED_TAG.matches(tag)) return null
+        val build = builds[revision] ?: return null
+        val name = "normal_${revision}_${tag}.pbz"
+        if (build.name != name || build.size <= 0) return null
+        val digestHex = normalizeSha256Hex(build.sha256) ?: return null
+        val published = runCatching { Instant.parse(publishedAt) }.getOrNull() ?: return null
+        return VerifiedBuild(tag, published, "$PATCHED_DOWNLOAD_BASE/$tag/$name", build.size, digestHex)
+    }
