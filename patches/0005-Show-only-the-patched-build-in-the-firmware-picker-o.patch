+++ b/pebble/src/commonMain/kotlin/coredevices/pebble/firmware/GithubReleases.kt
@@ -82,6 +82,7 @@ class GithubReleases(
      * page and leaves the builds unlabeled.
      */
     suspend fun getBuildChoices(watch: WatchInfo): FirmwareBuildChoicesResult {
+        if (watch.platform.revision in PATCHED_REVISIONS) return getPatchedBuildChoices(watch)
         val list = when (val result = changelogList.fetch()) {
             is ChangelogListResult.Success -> result.list
             ChangelogListResult.RateLimited -> return FirmwareBuildChoicesResult.Failed(RATE_LIMITED_FAILURE)
@@ -146,6 +147,20 @@ class GithubReleases(
         val lookedUp: GithubReleaseDto?,
     )
 
+    /**
+     * Fork (consnop): on boards with patched builds the picker offers only what the update check
+     * would, so it never lists a stock build that drops the patches.
+     */
+    private suspend fun getPatchedBuildChoices(watch: WatchInfo): FirmwareBuildChoicesResult =
+        when (val result = getLatestPatchedFirmware(watch)) {
+            is FirmwareUpdateCheckResult.FoundUpdate -> FirmwareBuildChoicesResult.Success(
+                listOf(FirmwareBuildChoice(result, ChangelogListing.Unknown, isRecommended = true)),
+                listCheckedAt = null,
+            )
+            is FirmwareUpdateCheckResult.UpdateCheckFailed -> FirmwareBuildChoicesResult.Failed(result.error)
+            else -> FirmwareBuildChoicesResult.Success(emptyList(), listCheckedAt = null)
+        }
+
     /**
      * Fork (consnop): the newest patched build released by consnop/PebbleOS, for the boards in
      * [PATCHED_REVISIONS], read from the `firmware-feed.json` its pipeline attaches to each release.
