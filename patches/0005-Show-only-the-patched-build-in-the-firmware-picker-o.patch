diff --git a/pebble/src/commonMain/kotlin/coredevices/pebble/firmware/GithubReleases.kt b/pebble/src/commonMain/kotlin/coredevices/pebble/firmware/GithubReleases.kt
index e5e86fdd..c4b8e3a4 100644
