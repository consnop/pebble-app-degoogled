+    @Test
+    fun thePickerOffersOnlyThePatchedBuild() = runTest {
+        val feed = Feed(feed("v4.46.0-consnop-cccccccc"))
+        val choices = assertIs<FirmwareBuildChoicesResult.Success>(
+            feed.checker.getBuildChoices(testWatchInfo(CORE_OBELIX_PVT, "v4.45.0")),
+        )
+        val choice = choices.builds.single()
+        assertTrue(choice.isRecommended, "the only build must be preselected")
+        assertTrue(choice.update.url.endsWith("/v4.46.0-consnop-cccccccc/normal_${board}_v4.46.0-consnop-cccccccc.pbz"))
+        assertEquals(listOf(FEED_URL), feed.requests.map { it.url.toString() }, "the picker must not ask the REST API")
+    }
+
+    @Test
+    fun thePickerShowsNothingNewerAndFeedFailures() = runTest {
+        assertEquals(
+            emptyList(),
+            assertIs<FirmwareBuildChoicesResult.Success>(
+                Feed(feed("v4.45.0-consnop-bbbbbbbb")).checker.getBuildChoices(testWatchInfo(CORE_OBELIX_PVT, "v4.45.0-consnop-bbbbbbbb")),
+            ).builds,
+        )
+        assertIs<FirmwareBuildChoicesResult.Failed>(
+            Feed("Not Found", HttpStatusCode.NotFound).checker.getBuildChoices(testWatchInfo(CORE_OBELIX_PVT, "v4.45.0")),
+        )
+    }
+
     private companion object {
         const val FEED_URL = "https://github.com/consnop/PebbleOS/releases/latest/download/firmware-feed.json"
